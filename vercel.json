{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/home", "destination": "/api/home.php" },
    { "source": "/booking", "destination": "/api/booking.php" },
    { "source": "/logout", "destination": "/api/logout.php" },
    { "source": "/admin/dashboard", "destination": "/api/admin_dashboard.php" },
    { "source": "/admin/login", "destination": "/api/admin_login.php" },
    { "source": "/admin/logout", "destination": "/api/admin_logout.php" },
    { "source": "/api-login", "destination": "/api/login.php" },
    { "source": "/api-register", "destination": "/api/register.php" },
    { "source": "/api-forgot", "destination": "/api/forgot_process.php" },
    { "source": "/api-reset", "destination": "/api/reset_password.php" },
    { "source": "/api-newsletter", "destination": "/api/newsletter.php" },
    { "source": "/api-booking", "destination": "/api/booking.php" }
  ]
}
